# Spotify OAuth (from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Vercel KV (from Vercel dashboard or Upstash)
KV_REST_API_URL=your_kv_url
KV_REST_API_TOKEN=your_kv_token

# The Spotify playlist ID to track (from the playlist URL)
# e.g., https://open.spotify.com/playlist/37i9dQZF1DXcBWIGoYBM5M → 37i9dQZF1DXcBWIGoYBM5M
PLAYLIST_ID=your_playlist_id
